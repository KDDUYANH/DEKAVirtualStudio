{
  "name": "background-engine",
  "productName": "Background Engine",
  "version": "1.0.0",
  "description": "Production-Ready Windows Background Engine for vMix and OBS (NDI High Bandwidth)",
  "main": "dist/main/main.js",
  "author": "DEKA Productions",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:ndi": "dotnet publish src/ndi/NdiBridge.csproj -c Release -r win-x64 --self-contained false -o bin/ndi",
    "build:ts": "tsc -p tsconfig.json",
    "build:copy": "powershell -Command \"New-Item -ItemType Directory -Force -Path dist/preview,dist/program,dist/detector; Copy-Item -Force src/preview/*.html,src/preview/*.css dist/preview; Copy-Item -Force src/program/*.html,src/program/*.css dist/program; Copy-Item -Force src/detector/*.html,src/detector/*.css dist/detector\"",
    "build": "npm run build:ndi && npm run build:ts && npm run build:copy",
    "start": "electron dist/main/main.js",
    "detector": "electron dist/detector/main.js",
    "detector:app": "electron dist/detector/main.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "detect": "node dist/tools/source-detector/detector.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.10",
    "7zip-bin": "^5.2.0",
    "app-builder-bin": "^4.0.0",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "build": {
    "appId": "com.deka.backgroundengine",
    "productName": "Background Engine",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "BackgroundEngine-Setup.${ext}"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/ndi",
        "to": "bin/ndi",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
